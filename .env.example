# 复制本文件为 .env，然后填入真实 key
# 1) 去 https://platform.deepseek.com 注册，拿 sk- 开头的 key
# 2) 粘贴到下面这一行
#
# 注意：这个文件只服务于本地 server.py。
# 线上（Cloudflare）不读 .env，而是在 Pages 项目里配环境变量：
#   Cloudflare 控制台 → 你的 Pages 项目 → Settings → Variables and Secrets
#   加一条 DEEPSEEK_API_KEY，类型选 Secret。变量名和这里保持一致。
DEEPSEEK_API_KEY=

# 可选：默认 deepseek-chat（便宜快），要更强可填 deepseek-reasoner
DEEPSEEK_MODEL=deepseek-chat

# ============ 聊天接口防刷 ============
# 这个接口每次调用都在烧 DeepSeek 余额。防护有三层，代码里写死了：
#   来源白名单 / 同一个人 3 秒 1 次 + 一天 60 次 / 全站一天 300 次
# 第一层的白名单默认放行 zqe.ccwu.cc 和 my-homepage-2hg.pages.dev，
# 本地开发另外自动放行 localhost / 127.0.0.1。
# 换域名时改这里就行，不用动代码（线上在 Pages 后台加同名变量）。
# 逗号分隔，写完整的 scheme://host，不要带结尾斜杠。
ALLOWED_ORIGINS=

# 一般不用改
DEEPSEEK_BASE_URL=https://api.deepseek.com
PORT=5000

# ============ 留言板 ============
# 管理口令：打开 /admin.html 管理留言要用它。
# 线上同样在 Pages 后台加一条 ADMIN_TOKEN，类型选 Secret。
# 留空 = 管理接口整个关闭（这是故意的：不能因为忘了配就变成谁都能删留言）。
ADMIN_TOKEN=

# 人机验证（可选）：Cloudflare 控制台 → Turnstile → 添加站点，拿到两个 key。
# site key 会发给浏览器（本来就要公开），secret key 只在服务端。
# 两个都填才会真正生效；不填就只靠 IP 限流顶着。
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
