# 复制本文件为 .env，然后填入真实 key
# 1) 去 https://platform.deepseek.com 注册，拿 sk- 开头的 key
# 2) 粘贴到下面这一行
#
# 注意：这个文件只服务于本地 server.py。
# 线上（Cloudflare）不读 .env，而是在 Pages 项目里配环境变量：
#   Cloudflare 控制台 → 你的 Pages 项目 → Settings → Variables and Secrets
#   加一条 DEEPSEEK_API_KEY，类型选 Secret。变量名和这里保持一致。
DEEPSEEK_API_KEY=

# 可选：默认 deepseek-chat（便宜快），要更强可填 deepseek-reasoner
DEEPSEEK_MODEL=deepseek-chat

# 一般不用改
DEEPSEEK_BASE_URL=https://api.deepseek.com
PORT=5000
