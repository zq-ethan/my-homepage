# 环境变量 / 密钥（绝不提交）
.env

# AI 助手的本地记忆与项目数据（含个人、学业等信息，绝不提交）
.workbuddy/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 本地测试报告与临时探测脚本（由 tools/*.mjs、tools/*.py 生成，属于临时产物）
# 不用只写 *.txt：探测脚本本身也是临时的，只忽略 .txt 会让 .py 探测脚本
# 以 ?? 形式挂在 git status 里（2026-09-21 实际踩到）。
tools/_report*
tools/_pwlog*.txt

# playwright-cli 的会话快照与临时截图（做浏览器验证时生成）
tools/.playwright-cli/
.playwright-cli/

# 留言板本地数据库（线上存 Cloudflare D1，这个只是本地开发用）
messages.db
messages.db-journal

# IDE
.vscode/
.idea/

# 系统
.DS_Store
Thumbs.db
